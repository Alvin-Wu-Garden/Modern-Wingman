{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: agent-service",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/apps/agent-service/AgentService.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "start: agent-service",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/start-all.ps1",
        "-AgentOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "start: wingman",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/start-all.ps1",
        "-DesktopOnly"
      ],
      "problemMatcher": []
    },
    {
      "label": "start: all",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/start-all.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "prepare: debug agent-service + wingman",
      "dependsOrder": "sequence",
      "dependsOn": [
        "build: agent-service",
        "start: wingman"
      ],
      "problemMatcher": []
    },
    {
      "label": "modern-wingman: start all",
      "type": "process",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/start-all.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "modern-wingman-debug",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "modern-wingman: stop all",
      "type": "process",
      "command": "pwsh.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/dev/stop-all.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "group": "modern-wingman-debug",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
