{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Modern Wingman AgentService（背景子程序）",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/apps/agent-service/bin/Debug/net10.0/AgentService.dll",
      "cwd": "${workspaceFolder}/apps/agent-service",
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5002",
        "COMPlus_ReadyToRun": "0"
      },
      "presentation": {
        "hidden": false
      }
    },
    {
      "name": "Modern Wingman Desktop（背景子程序）",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run --bin modern-wingman-desktop",
      "cwd": "${workspaceFolder}/apps/desktop/src-tauri",
      "presentation": {
        "hidden": false
      }
    }
  ],
  "compounds": [
    {
      "name": "Modern Wingman（全端 Debug）",
      "configurations": [
        "Modern Wingman AgentService（背景子程序）",
        "Modern Wingman Desktop（背景子程序）"
      ],
      "preLaunchTask": "modern-wingman: prepare debug",
      "postDebugTask": "modern-wingman: stop debug",
      "stopAll": true,
      "presentation": {
        "group": "modern-wingman",
        "order": 1
      }
    }
  ]
}
