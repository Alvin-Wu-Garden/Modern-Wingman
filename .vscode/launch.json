{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Modern Wingman AgentService（背景子程序）",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/apps/agent-service/AgentService.csproj",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Modern Wingman Desktop（背景子程序）",
      "type": "node-terminal",
      "request": "launch",
      "command": "cargo run --bin modern-wingman-desktop",
      "cwd": "${workspaceFolder}/apps/desktop/src-tauri",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Modern Wingman（全端 Debug）",
      "configurations": [
        "Modern Wingman AgentService（背景子程序）",
        "Modern Wingman Desktop（背景子程序）"
      ],
      "preLaunchTask": "modern-wingman: prepare debug",
      "postDebugTask": "modern-wingman: stop all",
      "stopAll": true,
      "presentation": {
        "group": "modern-wingman",
        "order": 1
      }
    }
  ]
}
