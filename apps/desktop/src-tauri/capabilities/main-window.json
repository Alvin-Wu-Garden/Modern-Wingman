[
  {
    "$schema": "../gen/schemas/windows-permission-schema.json",
    "identifier": "main-capability",
    "description": "Capability for the main application window",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "core:webview:allow-set-webview-zoom",
      "dialog:allow-open",
      "dialog:allow-save",
      "fs:allow-write-file",
      {
        "identifier": "opener:allow-open-path",
        "allow": [
          { "path": "$HOME/**" },
          { "path": "$DOWNLOAD/**" },
          { "path": "$DOCUMENT/**" },
          { "path": "$DESKTOP/**" },
          { "path": "$APPDATA/**" },
          { "path": "$APPLOCALDATA/**" },
          { "path": "$TEMP/**" }
        ]
      }
    ]
  }
]
