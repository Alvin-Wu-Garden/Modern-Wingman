{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "AgentService": "Debug"
    }
  },
  "AgentService": {
    "ActiveProfileId": "copilot-default"
  },
  "Neo4jLifecycle": {
    "Mode": "managed",
    "PreserveManagedProcessOnShutdown": true
  },
  "GraphRAG": {
    "includeCodeChunkText": false
  },
  "LocalJiraFiles": {
    "Enabled": false,
    "Directory": "../../temp/jira-samples"
  }
}
