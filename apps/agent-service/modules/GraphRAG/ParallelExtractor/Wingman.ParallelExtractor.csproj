<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Wingman.ParallelExtractor</AssemblyName>
    <RootNamespace>AgentService.Modules.GraphRAG.ParallelExtractor</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 協調與發布屬於 AgentService；此專案只保存可獨立驗證的抽取演算法。 -->
    <Compile Remove="ParallelExtractorPipeline.cs" />
    <InternalsVisibleTo Include="AgentService.CoreRegression" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本與原始 ParallelExtractor.csproj 完全一致。 -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Esprima" Version="3.0.6" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
    <PackageReference Include="Neo4j.Driver" Version="6.3.0" />
  </ItemGroup>
</Project>
