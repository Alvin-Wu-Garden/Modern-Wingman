{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://localhost:5001",
        "Protocols": "Http2"
      },
      "Rest": {
        "Url": "http://localhost:5002",
        "Protocols": "Http1"
      }
    }
  },
  "AgentService": {
    "ActiveProfileId": "copilot-default",
    "ModelProviders": [
      {
        "Id": "copilot-default",
        "DisplayName": "GitHub Copilot",
        "Kind": "CopilotDefault",
        "ProviderType": "github"
      },
      {
        "Id": "openai-byok",
        "DisplayName": "OpenAI",
        "Kind": "CopilotByok",
        "ModelId": "gpt-4.1",
        "ProviderType": "openai",
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKeyEnvVar": "OPENAI_API_KEY"
      },
      {
        "Id": "anthropic-byok",
        "DisplayName": "Anthropic",
        "Kind": "CopilotByok",
        "ModelId": "claude-sonnet-4-5",
        "ProviderType": "anthropic",
        "BaseUrl": "https://api.anthropic.com",
        "ApiKeyEnvVar": "ANTHROPIC_API_KEY"
      },
      {
        "Id": "openrouter-byok",
        "DisplayName": "OpenRouter",
        "Kind": "CopilotByok",
        "ModelId": "openai/gpt-4o-mini",
        "ProviderType": "openai",
        "BaseUrl": "https://openrouter.ai/api/v1",
        "ApiKeyEnvVar": "OPENROUTER_API_KEY"
      },
      {
        "Id": "azure-openai-byok",
        "DisplayName": "Azure OpenAI",
        "Kind": "CopilotByok",
        "ModelId": "gpt-4",
        "ProviderType": "azure",
        "BaseUrl": "https://YOUR-RESOURCE.openai.azure.com",
        "ApiKeyEnvVar": "AZURE_OPENAI_KEY",
        "AzureApiVersion": "2024-10-21"
      },
      {
        "Id": "azure-foundry-byok",
        "DisplayName": "Azure AI Foundry",
        "Kind": "CopilotByok",
        "ModelId": "gpt-5",
        "ProviderType": "openai",
        "BaseUrl": "https://YOUR-RESOURCE.openai.azure.com/openai/v1/",
        "ApiKeyEnvVar": "AZURE_FOUNDRY_KEY",
        "WireApi": "responses"
      },
      {
        "Id": "custom-byok",
        "DisplayName": "Custom Endpoint",
        "Kind": "CopilotByok",
        "ModelId": "my-model",
        "ProviderType": "openai",
        "BaseUrl": "http://localhost:11434/v1",
        "ApiKeyEnvVar": "CUSTOM_API_KEY"
      }
    ]
  },
  "Neo4j": {
    "Uri": "bolt://127.0.0.1:17688",
    "Username": "neo4j",
    "Password": "",
    "Database": "neo4j",
    "ConnectionTimeoutSeconds": 3,
    "TransactionRetrySeconds": 60
  },
  "Neo4jLifecycle": {
    "Mode": "managed",
    "DownloadUrl": "https://dist.neo4j.org/neo4j-community-5.26.0-windows.zip",
    "JreDownloadUrl": "https://api.adoptium.net/v3/binary/latest/21/ga/windows/x64/jre/hotspot/normal/eclipse",
    "OfflinePackageDir": null
  },
  "SpeechToText": {
    "DefaultModelId": "small-q5_1",
    "DefaultLanguage": "auto",
    "MaxRecordingSeconds": 120
  },
  "LlmTelemetry": {
    "FirstTokenTimeoutSeconds": 60,
    "IdleStreamTimeoutSeconds": 120,
    "TotalRequestTimeoutSeconds": 600,
    "FallbackEnabled": false,
    "MaxFirstTokenRetriesPerTarget": 1,
    "AllowCrossProviderFallback": false,
    "FallbackTargets": [],
    "StoreContentPreviews": false,
    "ContentPreviewChars": 240
  },
  "Audit": {
    "RetentionDays": 365
  }
}
