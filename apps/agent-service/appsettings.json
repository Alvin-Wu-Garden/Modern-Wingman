{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "127.0.0.1;localhost",
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://127.0.0.1:5002",
        "Protocols": "Http1"
      }
    }
  },
  "AgentService": {
    "ActiveProfileId": "copilot-default",
    "ModelProviders": [
      {
        "Id": "copilot-default",
        "DisplayName": "GitHub Copilot",
        "Kind": "CopilotDefault",
        "ProviderType": "github"
      },
      {
        "Id": "openai-byok",
        "DisplayName": "OpenAI",
        "Kind": "CopilotByok",
        "ModelId": "gpt-5.6",
        "Protocol": "OpenAI",
        "BaseUrl": "https://api.openai.com/v1"
      },
      {
        "Id": "anthropic-byok",
        "DisplayName": "Anthropic",
        "Kind": "CopilotByok",
        "ModelId": "claude-sonnet-4-5",
        "Protocol": "Anthropic",
        "BaseUrl": "https://api.anthropic.com"
      },
      {
        "Id": "openrouter-byok",
        "DisplayName": "OpenRouter",
        "Kind": "CopilotByok",
        "ModelId": "openai/gpt-4o-mini",
        "Protocol": "OpenAICompatible",
        "BaseUrl": "https://openrouter.ai/api/v1"
      },
      {
        "Id": "azure-openai-byok",
        "DisplayName": "Azure OpenAI",
        "Kind": "CopilotByok",
        "ModelId": "gpt-4",
        "Protocol": "AzureOpenAI",
        "BaseUrl": "https://YOUR-RESOURCE.openai.azure.com",
        "AzureApiVersion": "2024-10-21"
      },
      {
        "Id": "custom-byok",
        "DisplayName": "Custom Endpoint",
        "Kind": "CopilotByok",
        "ModelId": "my-model",
        "Protocol": "OpenAICompatible",
        "BaseUrl": "http://localhost:11434/v1"
      }
    ]
  },
  "ConversationRuntime": {
    "GeneralTimeoutSeconds": 300,
    "ProjectAnalysisTimeoutSeconds": 600
  },
  "Neo4j": {
    "Uri": "bolt://127.0.0.1:17688",
    "Username": "neo4j",
    "Password": "",
    "Database": "neo4j",
    "ConnectionTimeoutSeconds": 3,
    "TransactionRetrySeconds": 60,
    "WriteBatchSize": 1000
  },
  "GraphRAG": {
    "Retrieval": {
      "MaximumQueryVariants": 10,
      "EnableLlmQueryRewrite": true,
      "LlmQueryRewriteTimeoutSeconds": 8,
      "MaximumLlmQueryVariants": 6
    }
  },
  "Neo4jLifecycle": {
    "Mode": "managed",
    "DownloadUrl": "https://dist.neo4j.org/neo4j-community-5.26.0-windows.zip",
    "JreDownloadUrl": "https://api.adoptium.net/v3/binary/latest/21/ga/windows/x64/jre/hotspot/normal/eclipse",
    "OfflinePackageDir": null
  },
  "SpeechToText": {
    "DefaultModelId": "small-q5_1",
    "DefaultLanguage": "auto",
    "MaxRecordingSeconds": 120
  }
}
